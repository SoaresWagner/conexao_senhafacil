  name: Build Conexao Remota (Windows White-Label)

on:
  workflow_dispatch:
    inputs:
      public_key:
        description: 'Chave Publica do Servidor (id_ed25519.pub)'
        required: true
        default: 'COLE_SUA_CHAVE_PUBLICA_AQUI'
      app_name:
        description: 'Nome do Aplicativo na Janela'
        required: true
        default: 'Conexão Remota'
      hide_network_settings:
        description: 'Ocultar configuracoes de servidor/rede do usuario?'
        type: boolean
        default: true

env:
  SCITER_RUST_VERSION: "1.75"
  RUST_VERSION: "1.75"
  LLVM_VERSION: "15.0.6"
  FLUTTER_VERSION: "3.24.5"
  VCPKG_BINARY_SOURCES: "clear;x-gha,readwrite"
  VCPKG_COMMIT_ID: "9e593bb18ea69cc5095e012465dcd675a822ed0d"
  VERSION: "1.5.1"

jobs:
  generate-bridge:
    uses: ./.github/workflows/bridge.yml

  build-RustDeskTempTopMostWindow:
    uses: ./.github/workflows/third-party-RustDeskTempTopMostWindow.yml
    with:
      upload-artifact: true
      target: windows-2022
      configuration: Release
      platform: x64
      target_version: Windows10

  build-for-windows-flutter:
    name: Windows x64 White-Label
    needs: [build-RustDeskTempTopMostWindow, generate-bridge]
    runs-on: windows-2022
    strategy:
      fail-fast: false
      matrix:
        job:
          - {
              target: x86_64-pc-windows-msvc,
              os: windows-2022,
              arch: x86_64,
              flutter-arch: x64,
              vcpkg-triplet: x64-windows-static,
              build-args: "--vram",
            }
    steps:
      - name: Export GitHub Actions cache environment variables
        uses: actions/github-script@d7906e4ad0b1822421a7e6a35d5ca353c962f410
        with:
          script: |
            core.exportVariable('ACTIONS_CACHE_URL', process.env.ACTIONS_CACHE_URL || '');
            core.exportVariable('ACTIONS_RUNTIME_TOKEN', process.env.ACTIONS_RUNTIME_TOKEN || '');

      - name: Checkout source code (com submodulos hbb_common)
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          submodules: recursive

      - name: Restore bridge files
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: bridge-artifact
          path: ./

      # =========================================================================
      # PASSO WHITE-LABEL: INJETA SERVIDOR, API, KEY E TROCA O NOME RUSTDESK
      # =========================================================================
      - name: Customizar Conexao Remota (White-Label)
        shell: pwsh
        run: |
          $appName = "${{ inputs.app_name }}"
          $pubKey  = "${{ inputs.public_key }}".Trim()

          Write-Host "Injetando configuracoes em libs/hbb_common/src/config.rs..."
          $configPath = "libs/hbb_common/src/config.rs"
          $config = Get-Content $configPath -Raw -Encoding UTF8

          # 1. Altera o nome do aplicativo no core em Rust
          $config = $config -replace 'pub static ref APP_NAME: RwLock<String> = RwLock::new\("RustDesk"\.to_owned\(\)\);', "pub static ref APP_NAME: RwLock<String> = RwLock::new(`"$appName`".to_owned());"

          # 2. Altera o servidor de ID/Relay (RENDEZVOUS_SERVERS)
          $config = $config -replace 'pub const RENDEZVOUS_SERVERS: &\[&str\] = &\[[^\]]*\];', 'pub const RENDEZVOUS_SERVERS: &[&str] = &["conexao.senhafacil.app.br:21116"];'

          # 3. Altera a Chave Publica (RS_PUB_KEY)
          $config = $config -replace 'pub const RS_PUB_KEY: &str = "[^"]*";', "pub const RS_PUB_KEY: &str = `"$pubKey`";"

          Set-Content -Path $configPath -Value $config -Encoding UTF8

          # 4. Altera o API Server padrao em src/common.rs
          Write-Host "Injetando API Server em src/common.rs..."
          $commonPath = "src/common.rs"
          $common = Get-Content $commonPath -Raw -Encoding UTF8
          $common = $common -replace 'https://admin\.rustdesk\.com', 'https://conexao.senhafacil.app.br'
          Set-Content -Path $commonPath -Value $common -Encoding UTF8

          # 5. Troca os textos 'RustDesk' visiveis nas telas e traducoes do Flutter (PT-BR / EN)
          Write-Host "Personalizando textos da interface Flutter..."
          $langFiles = Get-ChildItem -Path "src/lang" -Filter "*.rs"
          foreach ($f in $langFiles) {
            (Get-Content $f.FullName -Raw -Encoding UTF8) -replace 'RustDesk', $appName | Set-Content $f.FullName -Encoding UTF8
          }

          # 6. Opcional: Esconde o menu de alterar servidor ID/Relay nas Configuracoes de Rede
          if ("${{ inputs.hide_network_settings }}" -eq "true") {
            $settingsPage = "flutter/lib/desktop/pages/settings_page.dart"
            if (Test-Path $settingsPage) {
              $spContent = Get-Content $settingsPage -Raw -Encoding UTF8
              $spContent = $spContent -replace 'if \(!bind\.isIncomingOnly\(\) && !bind\.isOutgoingOnly\(\)\)\s*SettingsMenu\.idRelay,', '// Ocultado no White-Label'
              Set-Content -Path $settingsPage -Value $spContent -Encoding UTF8
            }
          }

          Write-Host "Verificando alteracoes aplicadas:"
          Select-String -Path $configPath -Pattern "APP_NAME|RENDEZVOUS_SERVERS|RS_PUB_KEY"

      - name: Install LLVM and Clang
        uses: KyleMayes/install-llvm-action@ebc0426251bc40c7cd31162802432c68818ab8f0
        with:
          version: ${{ env.LLVM_VERSION }}

      - name: Install flutter
        id: flutter
        uses: subosito/flutter-action@2783a3f08e1baf891508463f8c6653c258246225
        with:
          channel: "stable"
          flutter-version: ${{ env.FLUTTER_VERSION }}
          architecture: x64

      - name: Replace engine with rustdesk custom flutter engine
        run: |
          flutter doctor -v
          flutter precache --windows
          Invoke-WebRequest -Uri https://github.com/rustdesk/engine/releases/download/main/windows-x64-release.zip -OutFile windows-x64-release.zip
          Expand-Archive -Path windows-x64-release.zip -DestinationPath windows-x64-release
          mv -Force windows-x64-release/* C:/hostedtoolcache/windows/flutter/stable-${{ env.FLUTTER_VERSION }}-x64/bin/cache/artifacts/engine/windows-x64-release/

      - name: Patch flutter
        shell: bash
        run: |
          cp .github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff $(dirname $(dirname $(which flutter)))
          cd $(dirname $(dirname $(which flutter)))
          if [[ "3.24.5" == ${{env.FLUTTER_VERSION}} ]]; then
            git apply flutter_3.24.4_dropdown_menu_enableFilter.diff
          fi

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9
        with:
          toolchain: ${{ env.SCITER_RUST_VERSION }}
          targets: ${{ matrix.job.target }}
          components: "rustfmt"

      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32
        with:
          prefix-key: ${{ matrix.job.os }}

      - name: Setup vcpkg with Github Actions binary cache
        uses: lukka/run-vcpkg@b1a0dd252f06b9e25b3c022a9a03bd7a427fb6a2
        with:
          vcpkgDirectory: C:\vcpkg
          vcpkgGitCommitId: ${{ env.VCPKG_COMMIT_ID }}
          doNotCache: false

      - name: Install vcpkg dependencies
        env:
          VCPKG_DEFAULT_HOST_TRIPLET: ${{ matrix.job.vcpkg-triplet }}
        shell: bash
        run: |
          $VCPKG_ROOT/vcpkg install --triplet ${{ matrix.job.vcpkg-triplet }} --x-install-root="$VCPKG_ROOT/installed"

      - name: Build rustdesk
        run: |
          python3 .\build.py --portable --flutter --skip-portable-pack --hwcodec ${{ matrix.job.build-args }}
          mv ./flutter/build/windows/${{ matrix.job.flutter-arch }}/runner/Release ./rustdesk

          Invoke-WebRequest -Uri https://github.com/rustdesk-org/rdev/releases/download/usbmmidd_v2/usbmmidd_v2.zip -OutFile usbmmidd_v2.zip
          Expand-Archive usbmmidd_v2.zip -DestinationPath .
          Remove-Item -Path usbmmidd_v2\Win32 -Recurse
          Remove-Item -Path "usbmmidd_v2\deviceinstaller64.exe", "usbmmidd_v2\deviceinstaller.exe", "usbmmidd_v2\usbmmidd.bat"
          mv -Force .\usbmmidd_v2 ./rustdesk

      - name: find Runner.res
        continue-on-error: true
        shell: bash
        run: |
          runner_res=$(find . -name "Runner.res");
          if [ "$runner_res" != "" ]; then
            cp $runner_res ./libs/portable/Runner.res;
          fi

      - name: Download RustDeskTempTopMostWindow artifacts
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: topmostwindow-artifacts-x64
          path: "./rustdesk"

      - name: Gerar Executavel Final (ConexaoRemota.exe)
        shell: bash
        run: |
          sed -i '/dpiAware/d' res/manifest.xml
          pushd ./libs/portable
          pip3 install -r requirements.txt
          python3 ./generate.py -f ../../rustdesk/ -o . -e ../../rustdesk/rustdesk.exe
          popd
          mkdir -p ./OutputExe
          mv ./target/release/rustdesk-portable-packer.exe ./OutputExe/ConexaoRemota-Setup.exe

      - name: Disponibilizar Executavel para Download (Artifact)
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: ConexaoRemota-Windows-x64
          path: ./OutputExe/ConexaoRemota-Setup.exe
